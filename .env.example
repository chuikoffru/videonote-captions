# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key для Whisper API (транскрипция голоса в текст)
OPENAI_API_KEY=your_openai_api_key_here

# Опционально: Настройки видео
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2000k

# Настройки монетизации
# Стоимость каждых 60 секунд сверх бесплатного лимита (в Telegram Stars)
# Рекомендуемые значения: 3-10 Stars (при Whisper API $0.006/мин)
STARS_PER_MINUTE=10

# Бесплатный лимит в секундах
FREE_SECONDS=60

# Стоимость вертикального видео (в Telegram Stars)
VERTICAL_COST=5

# ID администратора (Telegram User ID)
# Для админа нет лимита по длительности голосовых сообщений
ADMIN_ID=your_telegram_user_id

# ЮКасса интеграция (для внутренней системы кредитов)
# Получите provider_token через @BotFather -> Payments -> Connect ЮKassa
YUKASSA_PROVIDER_TOKEN=your_provider_token_here

# Пакеты кредитов (опционально, есть значения по умолчанию)
# Пакет 1: 100 кредитов за 99 рублей
CREDIT_PACKAGE_1_AMOUNT=100
CREDIT_PACKAGE_1_PRICE=99
# Пакет 2: 300 кредитов за 249 рублей
CREDIT_PACKAGE_2_AMOUNT=300
CREDIT_PACKAGE_2_PRICE=249
# Пакет 3: 1000 кредитов за 749 рублей
CREDIT_PACKAGE_3_AMOUNT=1000
CREDIT_PACKAGE_3_PRICE=749
